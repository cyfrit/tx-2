diff --git a/assembler/src/asmlib/driver/tests.rs b/assembler/src/asmlib/driver/tests.rs
index 192a6ee..85f344a 100644
--- a/assembler/src/asmlib/driver/tests.rs
+++ b/assembler/src/asmlib/driver/tests.rs
@@ -1214,3 +1214,35 @@ fn test_diagnose_duplicate_tags_in_macro_body() {
     assert_ne!(errors.as_slice(), []);
     assert!(errors.iter().any(|e| e.to_string().contains(expected_msg)));
 }
+
+#[test]
+fn sketchpad_equality_alias_reserves_temporary_storage_before_listing() {
+    let program = assemble_source("ALIAS = SCRATCH+1\n100| LDA ALIAS\n", Default::default())
+        .expect("an equality may refer to automatically assigned storage");
+    assert_eq!(program.chunks[0].words[0], u36!(0o002400000102));
+    assert_eq!(program.chunks[1].address, Address::from(u18!(0o101)));
+    assert_eq!(program.chunks[1].words, vec![u36!(0)]);
+}
+
+#[test]
+fn sketchpad_rc_follows_last_manuscript_block_not_highest_address() {
+    let program = assemble_source("300| 1\n100| LDA {2}\n", Default::default())
+        .expect("descending block addresses are legal M4");
+    assert_eq!(program.chunks[1].words[0], u36!(0o002400000101));
+    assert_eq!(program.chunks[2].address, Address::from(u18!(0o101)));
+    assert_eq!(program.chunks[2].words, vec![u36!(2)]);
+}
+
+#[test]
+fn sketchpad_integer_expressions_and_default_exit_selector() {
+    let program = assemble_source("100| 4-6\n-2+6\n0/0\n(0/0 @xor@ 1) @times@ 200\n", Default::default())
+        .expect("negative integers and the LGORR default selector must assemble");
+    assert_eq!(program.chunks[0].words, vec![u36!(0o777777777775), u36!(4), u36!(0), u36!(0o200)]);
+}
+
+#[test]
+fn sketchpad_not_hold_before_configuration_overrides_opcode_default() {
+    let program = assemble_source("100| ℏ@sup_1@JNX@sub_3@400\n", Default::default())
+        .expect("not-hold may precede the configuration syllable");
+    assert_eq!(program.chunks[0].words[0], u36!(0o010703000400));
+}
